---
// BlogPost layout: plain header with the byline (Dr. Edward Shut, DPT, license PT 301809, linking to
// About), the answer in the first two sentences, the body, the sources named beside each claim and listed
// at the end, the author bio, the booking band and the related links.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Blocks from '../Blocks.astro';
import Inline from '../Inline.astro';
import BookingBlock from '../kit/BookingBlock.astro';
import RelatedLinks from '../kit/RelatedLinks.astro';
import FAQ from '../kit/FAQ.astro';
import type { PostContent, Block } from '../../lib/types';
import { pageById, crumbsFor } from '../../lib/pages';
import { breadcrumbNode, faqNode, webPageNode, imageRefNode, graph, abs, CLINIC_ID, PERSON_ID } from '../../lib/schema';
import { BUSINESS, SITE_URL } from '../../data/site';
import { plainInline } from '../../lib/inline';
interface Props {
  post: PostContent;
}
const { post } = Astro.props;
const meta = pageById(post.id);
if (meta.path !== post.path) throw new Error(`${post.id}: path mismatch`);
const crumbs = crumbsFor(meta);
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// The post's image, or the desk portrait when it has none (also its share image).
const shareImage = post.image ?? { src: '/img/dr-ed-shut-in-clinic-chatsworth.webp', width: 1000, height: 1000, alt: 'Dr. Edward Shut, DPT, at his desk in the Chatsworth Physical Therapy clinic' };
const breadcrumb = breadcrumbNode(crumbs);
const nodes: Record<string, unknown>[] = [
  webPageNode(post.path, post.title, 'WebPage', {
    description: post.description,
    breadcrumb: { '@id': breadcrumb['@id'] },
    mainEntity: { '@id': `${abs(post.path)}#post` },
    primaryImageOfPage: imageRefNode(shareImage),
    datePublished: post.datePublished,
    dateModified: post.dateModified ?? post.datePublished,
  }),
  {
    '@type': 'BlogPosting',
    '@id': `${abs(post.path)}#post`,
    headline: post.h1,
    description: post.description,
    datePublished: post.datePublished,
    dateModified: post.dateModified ?? post.datePublished,
    mainEntityOfPage: { '@id': `${abs(post.path)}#webpage` },
    url: abs(post.path),
    image: abs(shareImage.src),
    author: { '@type': 'Person', '@id': PERSON_ID, name: 'Edward Shut', honorificSuffix: 'DPT', url: abs('/about-us/') },
    // 25 Oct 2026: a plain Organization reference. Typed as the clinic, Google's test read the publisher as a separate
    // Local business item missing its address, phone and image (those live on the homepage and contact page node).
    publisher: { '@type': 'Organization', '@id': CLINIC_ID, name: BUSINESS.name, url: `${SITE_URL}/` },
    ...(post.sources?.length ? { citation: post.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url, publisher: { '@type': 'Organization', name: s.publisher } })) } : {}),
  },
];
if (post.faqs?.length) nodes.push(faqNode(post.faqs));
nodes.push(breadcrumb);
const schema = graph(nodes);
const body = post.body;
---
<BaseLayout pageId={meta.id} path={meta.path} title={post.title} description={post.description} ogType="article" ogImage={shareImage.src} ogImageMeta={{ alt: shareImage.alt, width: shareImage.width, height: shareImage.height }} schema={schema} bookHref={post.booking ? '#book' : '/contact/#book'}>
  <article>
    <header class="plain-hero">
      <div class="wrap">
        <Breadcrumbs crumbs={crumbs} />
        <h1 id="h1">{post.h1}</h1>
        <div class="post-meta">
          <span class="byline"><img src="/img/dr-ed-shut-dpt-headshot-chatsworth.webp" alt="Dr. Edward Shut, DPT" width="240" height="240" /><span>By <a href="/about-us/">Dr. Edward Shut, DPT</a>, California license PT 301809</span></span>
          <span><time datetime={post.datePublished}>{fmt(post.datePublished)}</time></span>
          <span><a href={post.parent.href}>{post.parent.text}</a></span>
        </div>
      </div>
    </header>
    <section class="sec tone-white">
      <div class="wrap post-wrap">
        <div class="post-body">
          <Inline as="p" class="post-answer" text={post.answer} />
          {post.image && (
            <figure class="post-figure"><img src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} loading="lazy" decoding="async" /></figure>
          )}
          {body.map((b) => (b.type === 'h2' ? <Inline as="h2" text={b.text} /> : <Blocks blocks={[b as Block]} />))}
        </div>
        {post.sources && post.sources.length > 0 && (
          <div class="sources post-body">
            <h2>Sources</h2>
            <ol>{post.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a>, {s.publisher}, read {s.accessed}{s.note ? `. ${s.note}` : ''}</li>)}</ol>
          </div>
        )}
        <aside class="author-box" aria-label="About the author">
          <img src="/img/dr-ed-shut-dpt-headshot-chatsworth.webp" alt="" width="240" height="240" loading="lazy" decoding="async" />
          <div>
            <p><strong>Dr. Edward Shut, DPT</strong> is the physical therapist at Chatsworth Physical Therapy, licensed by the Physical Therapy Board of California (license PT 301809), with 15+ years of experience treating patients. He sees every patient himself, in English or Russian.</p>
            <p><a href="/about-us/">About Dr. Edward</a></p>
          </div>
        </aside>
      </div>
    </section>
    {post.faqs && post.faqs.length > 0 && <FAQ h2="Questions about this" items={post.faqs} />}
  </article>
  {post.booking && <BookingBlock booking={post.booking} pageName={meta.name} />}
  <RelatedLinks links={post.related ?? []} />
</BaseLayout>
