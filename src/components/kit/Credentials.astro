---
// Credentials (About): the credential lines with check marks beside the framed diploma and license, the
// same frames, files, alt text and captions as the approved homepage. Without items it prints the
// homepage's four approved credential lines.
import type { Block } from '../../lib/types';
import { slugify } from '../../lib/inline';
import Inline from '../Inline.astro';
import Blocks from '../Blocks.astro';
import SectionHead from './SectionHead.astro';
interface Props {
  h2: string;
  intro?: string;
  items?: string[];
  blocks?: Block[];
  tone?: 'white' | 'sky';
  id?: string;
}
const HOME_LINES = [
  "Doctor of Physical Therapy, Mount Saint Mary's University",
  'B.S. in Exercise Science, Cal State Northridge',
  'Licensed by the Physical Therapy Board of California, license 301809',
  '15+ years of experience treating patients',
];
const { h2, intro, items = HOME_LINES, blocks = [], tone = 'white', id } = Astro.props;
const hid = 'h-' + (id ?? slugify(h2));
---
<section class:list={['sec', `tone-${tone}`]} id={id} aria-labelledby={hid}>
  <div class="wrap sec-split">
    <SectionHead h2={h2} id={hid} intro={intro} />
    <div>
      <ul class="cred-list">
        {items.map((it) => <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><Inline as="span" text={it} /></li>)}
      </ul>
      {blocks.length > 0 && <div class="prose" style="margin-top:1.2rem"><Blocks blocks={blocks} /></div>}
      <div class="cred-grid" style="margin-top:1.6rem">
        <figure class="cred-frame"><img src="/img/dpt-diploma-mount-saint-marys.webp" width="1000" height="754" alt="Dr. Shut's Doctorate of Physical Therapy diploma from Mount Saint Mary's University" loading="lazy" decoding="async" /><figcaption>Doctorate of Physical Therapy, as it hangs in the clinic</figcaption></figure>
        <figure class="cred-frame"><img src="/img/california-pt-license-301809.webp" width="1000" height="734" alt="Dr. Shut's Physical Therapy Board of California license, number 301809" loading="lazy" decoding="async" /><figcaption>Physical Therapy Board of California license</figcaption></figure>
      </div>
    </div>
  </div>
</section>
