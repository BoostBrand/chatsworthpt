---
// Renders a page's sections in the blueprint's order with the kit components. A 'custom' section is
// rendered from markup the page file passes in (the contact map, the reviews list, and so on).
import type { Section } from '../../lib/types';
import WhoThisIsFor from './WhoThisIsFor.astro';
import Treatment from './Treatment.astro';
import ConditionsList from './ConditionsList.astro';
import ReviewBlock from './ReviewBlock.astro';
import InsuranceNote from './InsuranceNote.astro';
import FAQ from './FAQ.astro';
import Cards from './Cards.astro';
import Steps from './Steps.astro';
import Credentials from './Credentials.astro';
import Social from './Social.astro';
import ReviewGroups from './ReviewGroups.astro';
import VideoStory from './VideoStory.astro';
import Visit from './Visit.astro';
import PostList from './PostList.astro';
interface Props {
  sections: Section[];
  custom?: Record<string, string>; // pre-rendered HTML for 'custom' sections, keyed by section id
}
const { sections, custom = {} } = Astro.props;
for (const s of sections) {
  if (s.kind === 'custom' && custom[s.id] === undefined) throw new Error(`No markup for custom section "${s.id}"`);
}
---
{sections.map((s) => {
  switch (s.kind) {
    case 'who':
      return <WhoThisIsFor h2={s.h2} intro={s.intro} items={s.items} outro={s.outro} tone={s.tone} id={s.id} />;
    case 'prose':
      return <Treatment h2={s.h2} intro={s.intro} blocks={s.blocks} tone={s.tone} layout={s.layout} id={s.id} />;
    case 'conditions':
      return <ConditionsList h2={s.h2} intro={s.intro} items={s.items} outro={s.outro} columns={s.columns} id={s.id} />;
    case 'review':
      return <ReviewBlock review={s.review} more={s.more} id={s.id} />;
    case 'insurance':
      return <InsuranceNote h2={s.h2} blocks={s.blocks} siteLines={s.siteLines} more={s.more} id={s.id} />;
    case 'faq':
      return <FAQ h2={s.h2} items={s.items} id={s.id} />;
    case 'cards':
      return <Cards h2={s.h2} intro={s.intro} cards={s.cards} groups={s.groups} outro={s.outro} columns={s.columns} tone={s.tone} id={s.id} />;
    case 'steps':
      return <Steps h2={s.h2} intro={s.intro} steps={s.steps} outro={s.outro} id={s.id} />;
    case 'credentials':
      return <Credentials h2={s.h2} intro={s.intro} items={s.items} blocks={s.blocks} tone={s.tone} id={s.id} />;
    case 'social':
      return <Social h2={s.h2} text={s.text} label={s.label} id={s.id} />;
    case 'reviews':
      return <ReviewGroups h2={s.h2} intro={s.intro} groups={s.groups} id={s.id} />;
    case 'video':
      return <VideoStory h2={s.h2} intro={s.intro} review={s.review} note={s.note} id={s.id} />;
    case 'visit':
      return <Visit h2={s.h2} intro={s.intro} blocks={s.blocks} id={s.id} photo={s.photo} photoCaption={s.photoCaption} />;
    case 'posts':
      return <PostList h2={s.h2} intro={s.intro} id={s.id} />;
    case 'custom':
      return <Fragment set:html={custom[s.id]} />;
    default:
      return null;
  }
})}
