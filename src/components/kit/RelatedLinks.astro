---
// RelatedLinks: the links the blueprint puts under the booking block, exact page names as anchors.
interface Props {
  links: { text: string; href: string }[];
}
const { links } = Astro.props;
---
{links.length > 0 && (
  <nav class="related" aria-label="Related pages">
    <div class="wrap"><span class="related-label">Related pages:</span>{links.map((l) => <a href={l.href}>{l.text}</a>)}</div>
  </nav>
)}
