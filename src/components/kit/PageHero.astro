---
// ServiceHero: the inner-page hero. Breadcrumbs, the exact H1, the promise line, Book (to #book) and the
// desktop call button, the stars line once, and the page's real photo or its labelled placeholder.
import type { Hero } from '../../lib/types';
import type { Crumb } from '../../lib/pages';
import { BUSINESS, RATING } from '../../data/site';
import Breadcrumbs from '../Breadcrumbs.astro';
import Inline from '../Inline.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
interface Props {
  hero: Hero;
  crumbs: Crumb[];
  hasBooking?: boolean;
}
const { hero, crumbs, hasBooking = true } = Astro.props;
const bookLabel = hero.book === false ? null : hero.book ?? 'Book my evaluation';
const bookHref = hasBooking ? '#book' : '/contact/#book';
const call = hero.call !== false;
const stars = hero.stars !== false;
const media = Boolean(hero.image || hero.placeholder);
// Optional width candidates (25 Oct 2026). The default sizes follow the hero column in site.css: the wrap is at most
// 1180px with 16px gutters, so the image is 455px wide from 1180px, five twelfths of the row less the 3.5rem gap
// from 960px, and the full row (100vw less the gutters) when the hero stacks below 960px.
const HERO_SIZES = '(min-width: 1180px) 455px, (min-width: 960px) calc((100vw - 88px) * 5 / 12), calc(100vw - 32px)';
const img = hero.image;
const srcset = img?.srcSet?.length ? img.srcSet.map((s) => `${s.src} ${s.width}w`).join(', ') : undefined;
const sizes = srcset ? img?.sizes ?? HERO_SIZES : undefined;
// Whole pictures keep their own shape: the inline ratio reserves the space before the file arrives.
const wholeStyle = img?.whole ? `aspect-ratio:${img.width} / ${img.height}` : undefined;
---
<section class:list={['page-hero', { 'no-media': !media }]} aria-labelledby="h1">
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <div class="page-hero-grid">
      <div class="page-hero-copy">
        <h1 id="h1">{hero.h1}</h1>
        <Inline as="p" class="page-hero-lede" text={hero.lede} />
        {hero.actions?.length ? (
          <div class="hero-cta">
            {hero.actions.map((a) => {
              const ext = /^https?:/.test(a.href);
              return <a class:list={['btn', a.style === 'ghost' ? 'btn-ghost' : 'btn-light']} href={a.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{a.text}</a>;
            })}
          </div>
        ) : (bookLabel || call) && (
          <div class="hero-cta">
            {hero.callFirst ? (
              <Fragment>
                <a class="btn btn-light" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>
                {bookLabel && <a class="btn btn-ghost" href={bookHref}>{bookLabel}</a>}
              </Fragment>
            ) : (
              <Fragment>
                {bookLabel && <a class="btn btn-light" href={bookHref}>{bookLabel}</a>}
                {call && <a class="btn btn-ghost btn-call-hero" href={BUSINESS.phoneHref}>Or call {BUSINESS.phone}</a>}
              </Fragment>
            )}
          </div>
        )}
        {stars && <div class="hero-proof"><span class="stars" aria-hidden="true">★★★★★</span><span>{RATING.line}</span></div>}
      </div>
      {media && (
        <figure class:list={['page-hero-media', { whole: img?.whole, tall: img?.whole && img.width / img.height < 1.2 }]}>
          {img ? (
            <picture>
              {img.srcMobile && <source media="(max-width: 700px)" srcset={img.srcMobile} />}
              <img src={img.src} srcset={srcset} sizes={sizes} alt={img.alt} width={img.width} height={img.height} style={wholeStyle} fetchpriority="high" decoding="async" />
            </picture>
          ) : (
            <PhotoPlaceholder label={hero.placeholder as string} />
          )}{img?.enlarge && <figcaption><a class="hero-enlarge" href={img.src}>View larger illustration<span class="vh"> for {img.enlarge}</span></a></figcaption>}
        </figure>
      )}
    </div>
  </div>
</section>
