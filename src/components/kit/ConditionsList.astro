---
// ConditionsList: the conditions a page treats, each linked down to its page where one exists.
import type { ConditionItem } from '../../lib/types';
import { slugify, renderInline } from '../../lib/inline';
import Inline from '../Inline.astro';
import SectionHead from './SectionHead.astro';
interface Props {
  h2: string;
  intro?: string;
  items: ConditionItem[];
  outro?: string;
  columns?: 1 | 2;
  id?: string;
}
const { h2, intro, items, outro, columns = 2, id } = Astro.props;
const hid = 'h-' + (id ?? slugify(h2));
---
<section class="sec tone-white" id={id} aria-labelledby={hid}>
  <div class="wrap">
    <SectionHead h2={h2} id={hid} intro={intro} />
    <ul class:list={['cond-list', { two: columns === 2 }]}>
      {items.map((it) => (
        <li>
          {it.href ? (
            <a href={it.href}><strong set:html={renderInline(it.text)} />{it.note && <small set:html={renderInline(it.note)} />}</a>
          ) : (
            <span class="row"><span set:html={renderInline(it.text)} />{it.note && <small set:html={renderInline(it.note)} />}</span>
          )}
        </li>
      ))}
    </ul>
    {outro && <Inline as="p" class="cond-note" text={outro} />}
  </div>
</section>
