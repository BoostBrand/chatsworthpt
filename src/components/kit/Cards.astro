---
// Cards for the services hub and the conditions hub: the real session photo where one exists, the exact
// page name as heading and link, one line on who it is for, and an optional line of what it covers.
import type { Card } from '../../lib/types';
import { slugify, renderInline } from '../../lib/inline';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import Inline from '../Inline.astro';
import SectionHead from './SectionHead.astro';
interface Props {
  h2: string;
  intro?: string;
  cards?: Card[];
  groups?: { title: string; cards: Card[] }[];
  outro?: string;
  columns?: 2 | 3;
  tone?: 'white' | 'sky';
  id?: string;
}
const { h2, intro, cards = [], groups = [], outro, columns = 3, tone = 'white', id } = Astro.props;
const hid = 'h-' + (id ?? slugify(h2));
const sets = groups.length ? groups : [{ title: '', cards }];
// Same grid as site.css: 16px page gutters, 20px gaps, and a 1px border on each card.
// Explicit image sizes can override these defaults without changing existing cards.
const imageSizes = columns === 2
  ? '(min-width: 1180px) 562px, (min-width: 640px) calc((100vw - 52px) / 2 - 2px), calc(100vw - 34px)'
  : '(min-width: 1180px) 368px, (min-width: 1000px) calc((100vw - 72px) / 3 - 2px), (min-width: 640px) calc((100vw - 52px) / 2 - 2px), calc(100vw - 34px)';
---
<section class:list={['sec', `tone-${tone}`]} id={id} aria-labelledby={hid}>
  <div class="wrap">
    <SectionHead h2={h2} id={hid} intro={intro} />
    {sets.map((g) => (
      <Fragment>
        {g.title && <h3 class="group-title">{g.title}</h3>}
        <ul class:list={['cards', { two: columns === 2 }]}>
          {g.cards.map((c) => (
            <li class="card">
              {(c.image || c.placeholder) && (
                <div class:list={['card-media', { whole: c.image?.whole }]}>
                  {c.image ? <img src={c.image.src} srcset={c.image.srcSet?.map((s) => `${s.src} ${s.width}w`).join(', ')} sizes={c.image.srcSet?.length ? c.image.sizes ?? imageSizes : undefined} alt={c.image.alt} width={c.image.width} height={c.image.height} loading="lazy" decoding="async" /> : <PhotoPlaceholder label={c.placeholder as string} />}
                </div>
              )}
              <div class="card-body">
                <h3><a href={c.href}>{c.title}</a></h3>
                <p set:html={renderInline(c.text)} />
                {c.meta && <p class="card-meta" set:html={renderInline(c.meta)} />}
              </div>
            </li>
          ))}
        </ul>
      </Fragment>
    ))}
    {outro && <Inline as="p" class="cond-note" text={outro} />}
  </div>
</section>

<style>
  /* Keep the existing aligned card frames while showing every edge of opted-in photos and diagrams. */
  .card-media.whole img { object-fit: contain; }
</style>
