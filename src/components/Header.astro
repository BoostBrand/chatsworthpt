---
// Sticky header (approved in draft 9). One menu on every page, the homepage included: Home, Services, Conditions,
// Dr. Edward, Reviews, New patients and Contact, with dropdowns for the three groups; aria-current="page" on the
// link that matches the path; the underline rests on the item for the current part of the site. Below
// 1180px the menu folds into the tap-open phone menu, whose groups open one at a time. Book goes to #book on
// the homepage and to /contact/#book on inner pages (blueprint section 3).
import { BUSINESS } from '../data/site';
import { NAV, MENU_LABEL, pageById, pageByPath, navSectionFor } from '../lib/pages';

interface Props {
  home?: boolean;
  current: string; // the page path, e.g. '/back-pain-therapy/'
  section?: string | null; // kept for callers; the menu works out the section from the page itself
}
const { home = false, current } = Astro.props;
const section = navSectionFor(pageByPath(current));
const items = NAV.map((n) => ({
  ...n,
  groups: (n.groups ?? []).map((g) => ({ title: g.title, pages: g.ids.map(pageById) })),
}));
const label = (p: { id: string; name: string }) => MENU_LABEL[p.id] ?? p.name;
const cur = (href: string) => (href === current ? { 'aria-current': 'page' } : {});
const bookHref = home ? '#book' : '/contact/#book';
const chevron = '<svg viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<header class="topbar has-mnav">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Chatsworth Physical Therapy home"><img src="/img/logo.svg" alt="Chatsworth Physical Therapy" width="788" height="367"></a>
    <nav class="nav" aria-label="Main">
      {items.map((n) =>
        n.groups.length ? (
          <div class="nav-item">
            <a href={n.href} class:list={[{ 'is-section': section === n.section && current !== n.href }]} {...cur(n.href)}>{n.label}<Fragment set:html={chevron} /></a>
            <div class:list={['menu-panel', `menu-${n.section}`]}>
              {n.groups.map((g) => (
                <ul>
                  {g.title && <li><p class="menu-label">{g.title}</p></li>}
                  {g.pages.map((p) => <li><a href={p.path} {...cur(p.path)}>{label(p)}</a></li>)}
                </ul>
              ))}
              {n.all && <div class="menu-all"><a href={n.all.href}>{n.all.text}</a></div>}
            </div>
          </div>
        ) : (
          <a href={n.href} {...cur(n.href)}>{n.label}</a>
        )
      )}
      <span class="nav-ink" aria-hidden="true"></span>
    </nav>
    <div class="top-actions">
      <a class="top-phone" href={BUSINESS.phoneHref}>{BUSINESS.phone}<small id="open-line">Mon to Sat, 10am to 8pm</small></a>
      <a class="btn btn-primary" href={bookHref}>Book an evaluation</a>
      <details class="mnav">
        <summary aria-label="Menu">
          <svg class="i-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </summary>
        <div class="mnav-panel">
          <div class="wrap">
            <ul class="mnav-list">
              {items.map((n) =>
                n.groups.length ? (
                  <li>
                    <details class="mnav-sub" open={section === n.section}>
                      <summary>{n.label}<Fragment set:html={chevron} /></summary>
                      <ul>
                        {n.groups.flatMap((g) => g.pages).map((p) => <li><a href={p.path} {...cur(p.path)}>{label(p)}</a></li>)}
                        {n.all && <li><a href={n.all.href} class="mnav-all" {...cur(n.all.href)}>{n.all.text}</a></li>}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li><a href={n.href} class="mnav-top" {...cur(n.href)}>{n.href === '/about-us/' ? 'About Dr. Edward' : n.label}</a></li>
                )
              )}
            </ul>
            <a class="btn btn-outline" href={BUSINESS.phoneHref}>Call {BUSINESS.phone}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
