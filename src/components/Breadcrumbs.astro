---
// Visible breadcrumb trail; BreadcrumbList in the page's JSON-LD mirrors it.
import type { Crumb } from '../lib/pages';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
