---
// Homepage, ported from the approved draft 9 (scripts/port-homepage.py writes this file; do not hand-edit
// the markup, edit the port script and run it again). Copy, structure and motion are unchanged; links to
// inner pages, root-relative asset paths, inline social icons and the booking switch are the only edits.
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import BookingForm from '../components/kit/BookingForm.astro';
import home from '../content/home';
import { CITY_PAGES_LIVE } from '../data/site';
import { SITE_URL } from '../data/site';
import { physiotherapyNode, personNode, reviewNode, faqNode, graph, abs, CLINIC_ID } from '../lib/schema';
const SITE_URL_SLASH = `${SITE_URL}/`;

const schema = graph([
  physiotherapyNode(home.reviews.map((r) => reviewNode(r.name, r.body))),
  personNode(),
  {
    '@type': 'VideoObject',
    ...home.video,
    thumbnailUrl: abs('/img/matt-and-dr-ed-chatsworth-pt.webp'),
    contentUrl: abs('/video/matt-frozen-shoulder-story-chatsworth-pt.mp4'),
    publisher: { '@id': CLINIC_ID },
  },
  faqNode(home.faqs),
  { '@type': 'WebSite', '@id': `${SITE_URL_SLASH}#website`, url: SITE_URL_SLASH, name: 'Chatsworth Physical Therapy', publisher: { '@id': CLINIC_ID } },
  {
    '@type': 'ImageObject',
    '@id': `${SITE_URL_SLASH}#hero-image`,
    contentUrl: abs('/img/hero-dr-ed-treating-patient-chatsworth.webp'),
    url: abs('/img/hero-dr-ed-treating-patient-chatsworth.webp'),
    width: 1800,
    height: 1125,
    caption: 'Dr. Ed Shut guiding a patient through a back exercise on the treatment table at Chatsworth Physical Therapy',
    creditText: 'Chatsworth Physical Therapy',
    copyrightNotice: 'Chatsworth Physical Therapy',
    creator: { '@id': CLINIC_ID },
  },
  {
    '@type': 'ImageObject',
    '@id': `${SITE_URL_SLASH}#portrait`,
    contentUrl: abs('/img/dr-ed-shut-in-clinic-chatsworth.webp'),
    url: abs('/img/dr-ed-shut-in-clinic-chatsworth.webp'),
    width: 1000,
    height: 1000,
    caption: 'Dr. Edward Shut, DPT, at his desk in the Chatsworth Physical Therapy clinic',
    creditText: 'Chatsworth Physical Therapy',
    copyrightNotice: 'Chatsworth Physical Therapy',
    creator: { '@id': CLINIC_ID },
  },
]);
---
<BaseLayout pageId="P-001" path="/" title={home.title} description={home.description} ogTitle={home.ogTitle} ogDescription={home.ogDescription} geo home schema={schema}>
<section class="hero" aria-labelledby="h1">
  <picture>
    <source media="(max-width: 700px)" srcset="/img/hero-dr-ed-treating-patient-chatsworth-mobile.webp">
    <img src="/img/hero-dr-ed-treating-patient-chatsworth.webp" width="1800" height="1125" alt="Dr. Ed Shut guiding a patient through a back exercise on the treatment table at Chatsworth Physical Therapy" fetchpriority="high">
  </picture>
  <div class="wrap">
    <div class="hero-inner">
      <h1 id="h1">Physical therapy in Chatsworth, one-on-one with Dr. Ed</h1>
      <p>Hands-on treatment for back pain, sports injuries and recovery after surgery. About an hour with a Doctor of Physical Therapy, every visit.</p>
      <div class="hero-cta">
        <a class="btn btn-light" href="#book">Book my evaluation</a>
        <a class="btn btn-ghost btn-call-hero" href="tel:+18187493205">Or call (818) 749-3205</a>
      </div>
      <div class="hero-proof"><span class="stars" aria-hidden="true">★★★★★</span><span>5.0 on Google, 28 reviews</span></div>
    </div>
  </div>
</section>

<section class="trust" aria-label="Why patients choose us">
  <div class="wrap">
    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="draw" pathLength="1" d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle class="draw" pathLength="1" cx="12" cy="7" r="4"/></svg><span><strong>One-on-one, start to finish</strong>You work with Dr. Ed himself at every visit, never handed off.</span></div>
    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle class="draw" pathLength="1" cx="12" cy="12" r="10"/><path class="draw" pathLength="1" d="M12 6v6l4 2"/></svg><span><strong>Open until 8pm, Monday to Saturday</strong>Appointments after work and on weekends.</span></div>
    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="draw" pathLength="1" d="M20 6 9 17l-5-5"/></svg><span><strong>Medicare accepted</strong>No referral needed to start. Call and begin this week.</span></div>
  </div>
</section>

<section class="band" id="services" aria-labelledby="h-services">
  <div class="wrap">
    <div class="section-head">
      <h2 id="h-services">What we treat</h2>
      <p class="lede">Most patients come in with one of these. Each page explains what the first visit looks like and what to expect from treatment.</p>
    </div>
    <div class="services">
      <div class="mosaic" aria-label="Real sessions at the clinic">
        <a href="/back-pain-therapy/" id="mosaic-lead"><img src="/img/back-pain-therapy-chatsworth.webp" width="900" height="900" alt="Dr. Ed guiding a patient through a core stability exercise for back pain at Chatsworth Physical Therapy" loading="lazy" decoding="async"><img class="mosaic-swap" id="mosaic-swap" src="/img/sports-injury-rehab-chatsworth.webp" width="900" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async"></a>
        <a href="/sports-injury-recovery/"><img src="/img/sports-injury-rehab-chatsworth.webp" width="900" height="900" alt="Ankle treatment during a sports injury rehab session in Chatsworth" loading="lazy" decoding="async"></a>
        <a href="/pre-post-surgical-rehabilitation/"><img src="/img/post-op-physical-therapy-chatsworth.webp" width="900" height="900" alt="Knee taping during post-op physical therapy in Chatsworth" loading="lazy" decoding="async"></a>
        <a href="/pain-management/"><img src="/img/red-light-therapy-chatsworth.webp" width="900" height="900" alt="Red light therapy session at Chatsworth Physical Therapy" loading="lazy" decoding="async"></a>
        <p class="mosaic-caption">Real sessions at the clinic. Every one of them is Dr. Ed.</p>
      </div>
      <ul class="service-list">
        <li><a href="/back-pain-therapy/" data-photo="/img/back-pain-therapy-chatsworth.webp"><strong>Back pain therapy</strong><span>Low back pain, sciatica, disc problems, posture</span></a></li>
        <li><a href="/sports-injury-recovery/" data-photo="/img/sports-injury-rehab-chatsworth.webp"><strong>Sports injury rehab</strong><span>Sprains, strains, ACL, rotator cuff, return to sport</span></a></li>
        <li><a href="/pre-post-surgical-rehabilitation/" data-photo="/img/post-op-physical-therapy-chatsworth.webp"><strong>Pre and post-op physical therapy</strong><span>Prehab before surgery, recovery after knee, hip and shoulder surgery</span></a></li>
        <li><a href="/orthopedic-rehabilitation/"><strong>Orthopedic rehabilitation</strong><span>Shoulder, elbow, hip, knee and ankle injuries</span></a></li>
        <li><a href="/balance-and-fall-prevention/"><strong>Balance, dizziness and vertigo</strong><span>Fall prevention and vestibular therapy, Medicare accepted</span></a></li>
        <li><a href="/pain-management/" data-photo="/img/red-light-therapy-chatsworth.webp"><strong>Pain management</strong><span>Manual therapy, red light, ultrasound and e-stim</span></a></li>
        <li><a href="/pediatric-physical-therapy/"><strong>Kids and teen athletes</strong><span>Gymnasts, dancers and school-age athletes, parent in the room</span></a></li>
        <li><a href="/neurological-rehabilitation/"><strong>Stroke and neurological rehab</strong><span>Strength, walking and everyday movement</span></a></li>
        <li><a href="/personal-training-weight-loss/"><strong>Personal training and weight loss</strong><span>The step after rehab, with the same doctor</span></a></li>
      </ul>
      <p class="unsure">Not sure which one you need? <a href="tel:+18187493205">Call (818) 749-3205</a> and Dr. Ed will tell you in two minutes.</p>
    </div>
    <p class="conditions"><strong>Conditions we treat most:</strong> <a href="/conditions/sciatica/">sciatica</a> and <a href="/conditions/herniated-disc/">herniated discs</a>, <a href="/conditions/shoulder-pain-rotator-cuff/">rotator cuff injuries</a> and <a href="/conditions/frozen-shoulder/">frozen shoulder</a>, <a href="/conditions/acl-recovery/">ACL</a> and <a href="/conditions/knee-pain/">meniscus injuries</a>, <a href="/conditions/ankle-sprain/">ankle sprains</a>, <a href="/conditions/plantar-fasciitis/">plantar fasciitis</a>, <a href="/sports-injury-recovery/">tennis elbow</a>, <a href="/conditions/neck-pain/">neck pain and pinched nerves</a>, <a href="/conditions/knee-replacement-recovery/">knee</a> and <a href="/conditions/hip-replacement-recovery/">hip replacement recovery</a>, <a href="/conditions/vertigo-bppv/">vertigo and BPPV</a>, <a href="/neurological-rehabilitation/">Parkinson's disease</a>, <a href="/neurological-rehabilitation/">stroke recovery</a>, <a href="/pediatric-physical-therapy/">back pain in young gymnasts and dancers</a>.</p>
  </div>
</section>

<section class="about band" id="about" aria-labelledby="h-about">
  <div class="wrap">
    <div class="about-photos">
      <figure class="portrait"><img src="/img/dr-ed-shut-in-clinic-chatsworth.webp" width="1000" height="1000" alt="Dr. Edward Shut, DPT, at his desk in the Chatsworth Physical Therapy clinic" loading="lazy" decoding="async"></figure>
      <figure class="cred-frame"><img src="/img/dpt-diploma-mount-saint-marys.webp" width="1000" height="754" alt="Dr. Shut's Doctorate of Physical Therapy diploma from Mount Saint Mary's University" loading="lazy" decoding="async"><figcaption>Doctorate of Physical Therapy, as it hangs in the clinic</figcaption></figure>
      <figure class="cred-frame"><img src="/img/california-pt-license-301809.webp" width="1000" height="734" alt="Dr. Shut's Physical Therapy Board of California license, number 301809" loading="lazy" decoding="async"><figcaption>Physical Therapy Board of California license</figcaption></figure>
    </div>
    <div class="about-copy">
      <h2 id="h-about">Meet Dr. Ed Shut, DPT, your physical therapist in Chatsworth</h2>
      <p>I'm Dr. Ed, a licensed physical therapist proudly serving patients in Chatsworth, CA and the surrounding area. My mission is to help people recover from injury, reduce pain, restore movement, and return to the activities that matter most to them.</p>
      <p>At Chatsworth PT, I take a personalized approach to care by working one-on-one with each patient. Every treatment plan is tailored to your specific needs and may include manual therapy, corrective exercise, therapeutic ultrasound, red light therapy, cryo massage, electrical stimulation, and practical education to support recovery and long-term wellness.</p>
      <ul class="creds">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Doctor of Physical Therapy, Mount Saint Mary's University</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>B.S. in Exercise Science, Cal State Northridge</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Licensed by the Physical Therapy Board of California, license 301809</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>15+ years of experience treating patients</li>
      </ul>
      <blockquote>"He is both very experienced at diagnosing the problems I've come in with, especially after hip replacement surgery, and he has also been intuitive about finding ways to fix my balance and strength."<cite>Susan, Google review, after hip replacement</cite></blockquote>
      <div><a class="btn btn-light" href="/about-us/">More about Dr. Ed</a></div>
      <SocialIcons label="Follow Dr. Ed" />
    </div>
  </div>
</section>

<section class="band" aria-labelledby="h-steps">
  <div class="wrap">
    <div class="section-head">
      <h2 id="h-steps"><a class="h-link" href="/first-visit/">How your first visit works</a></h2>
    </div>
    <div class="steps">
      <div class="step"><h3>Call or book online</h3><p>Pick an evening or Saturday slot if that is what fits. Tell us what hurts and we confirm your time, usually the same day.</p></div>
      <div class="step"><h3>An evaluation with Dr. Ed, about an hour</h3><p>He examines how you move, finds what is actually causing the pain, and explains it in plain terms.</p></div>
      <div class="step"><h3>A plan you can follow at home</h3><p>Hands-on treatment in the clinic plus a short home program, adjusted each visit as you progress.</p></div>
    </div>
    <div class="steps-cta">
      <a class="btn btn-primary" href="#book">Book my evaluation</a>
      <a class="btn btn-outline" href="tel:+18187493205">Call (818) 749-3205</a>
    </div>
  </div>
</section>

<section class="reviews band" id="reviews" aria-labelledby="h-reviews">
  <div class="wrap">
    <div class="reviews-head">
      <h2 id="h-reviews">What patients say about Chatsworth Physical Therapy</h2>
      <div class="reviews-meta">
        <div class="badge"><span class="stars" aria-hidden="true">★★★★★</span>5.0 on Google, 28 reviews</div>
        <span class="reviews-links"><a href="/reviews/">Read all 28 reviews</a> <a href="https://www.google.com/maps/search/?api=1&query=Chatsworth+Physical+Therapy&query_place_id=ChIJjzo2DhibwoAR1KeHYSgrQkE" target="_blank" rel="noopener">on Google</a></span>
      </div>
    </div>
    <div class="story">
      <div class="phone">
        <video id="story-video" preload="none" playsinline poster="/img/matt-and-dr-ed-chatsworth-pt.webp" width="720" height="1280" aria-label="Matt's frozen shoulder story, 42 seconds, captions on screen">
          <source src="/video/matt-frozen-shoulder-story-chatsworth-pt.mp4" type="video/mp4">
        </video>
        <button class="play" id="story-play" type="button" aria-label="Play Matt's story"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg><span>Watch Matt's story, 42 seconds</span></button>
      </div>
      <div class="story-copy">
        <p class="story-quote">"I came in with a frozen shoulder and very limited mobility. Remarkably, within just a few sessions, I began to regain movement. After a few weeks, I could lift my arm above my head and reach behind my back, something I hadn't been able to do at all before."</p>
        <p class="story-cite"><strong>Matthew</strong>, frozen shoulder, Google review</p>
        <p class="story-note">Matt came back to tell his story on camera. Captions are on screen, sound is optional.</p>
      </div>
    </div>
    <div class="cards">
      <article class="review"><span class="stars" aria-hidden="true">★★★★★</span><p>"He took the time to listen to my concerns, explain the treatment process, and made me feel comfortable during every visit. I've noticed a big improvement in my shoulder pain and mobility thanks to his care and guidance."</p><footer><strong>Mary</strong>, shoulder pain, Google review</footer></article>
      <article class="review"><span class="stars" aria-hidden="true">★★★★★</span><p>"I really appreciated how he customized my treatment plan based on my specific needs rather than using a one-size-fits-all approach. You can tell he genuinely cares about his patients and their progress."</p><footer><strong>Lauren</strong>, Google review</footer></article>
      <article class="review"><span class="stars" aria-hidden="true">★★★★★</span><p>"My daughter is 10 years old, a rhythmic gymnast, and had a back injury. Edward was very patient with her and worked very diligently with the problem. Results were already showing after 2 sessions."</p><footer><strong>Tati</strong>, parent of a young gymnast, Google review</footer></article>
    </div>
  </div>
</section>

<section class="visit band" id="visit" aria-labelledby="h-visit">
  <div class="wrap">
    <div>
      <h2 id="h-visit">Visit the clinic in Chatsworth</h2>
      <a class="map" href="https://www.google.com/maps/search/?api=1&query=Chatsworth+Physical+Therapy&query_place_id=ChIJjzo2DhibwoAR1KeHYSgrQkE" target="_blank" rel="noopener" aria-label="Open the clinic location in Google Maps">
        <span class="map-frame">
        <picture>
          <source media="(max-width: 600px)" srcset="/img/map-chatsworth-physical-therapy-19851-nordhoff-mobile.webp">
          <img src="/img/map-chatsworth-physical-therapy-19851-nordhoff.webp" width="1200" height="750" alt="Map showing Chatsworth Physical Therapy at 19851 Nordhoff Place, between Winnetka Avenue and Corbin Avenue, north of Nordhoff Street" loading="lazy" decoding="async">
        </picture>
        <span class="map-ping" aria-hidden="true"></span><span class="map-ping" aria-hidden="true"></span>
        </span>
        <span class="map-tag">19851 Nordhoff Pl, Unit 105 (Suite C), Chatsworth, CA 91311<small>Between Winnetka and Corbin, just north of Nordhoff St. Free parking in the lot in front, no gate code.</small></span>
      </a>
      <div class="visit-actions">
        <a class="btn btn-primary" href="https://www.google.com/maps/search/?api=1&query=Chatsworth+Physical+Therapy&query_place_id=ChIJjzo2DhibwoAR1KeHYSgrQkE" target="_blank" rel="noopener">Get directions</a>
        <a class="btn btn-outline" href="tel:+18187493205">Call (818) 749-3205</a>
      </div>
      <table class="facts">
        <tr><th>Hours</th><td>Monday to Saturday, 10am to 8pm<br>Sunday closed</td></tr>
        <tr><th>Phone</th><td><a href="tel:+18187493205">(818) 749-3205</a></td></tr>
        <tr><th>Email</th><td><a href="mailto:chatsworthpt@gmail.com">chatsworthpt@gmail.com</a></td></tr>
        <tr><th>Access</th><td>Wheelchair accessible entrance and parking. Street parking also available.</td></tr>
      </table>
      <p class="service-area">Patients come from Chatsworth, {CITY_PAGES_LIVE ? <a href="/physical-therapy-porter-ranch/">Porter Ranch</a> : 'Porter Ranch'}, {CITY_PAGES_LIVE ? <a href="/physical-therapy-northridge/">Northridge</a> : 'Northridge'}, West Hills, Canoga Park, Granada Hills and Simi Valley.</p>
    </div>
    <div id="faq">
      <h2>Common questions</h2>
      <div class="faq">
        <details><summary>Do I need a referral from my doctor?</summary><p>No. California law lets you see a physical therapist without a referral for up to 12 visits or 45 days, whichever comes first. After that, we need a referral from your doctor to continue. Medicare patients need a referral from the start.</p></details>
        <details><summary>Do you take insurance?</summary><p>We accept Medicare and personal injury liens. If you have PPO insurance, we provide a superbill, an itemized receipt you send to your insurer for reimbursement. Direct-pay patients are welcome. Call (818) 749-3205 and we will walk you through the cost before your first visit.</p></details>
        <details><summary>How long is each visit, and how many will I need?</summary><p>Visits run about 60 minutes, depending on what you need, and every one is one-on-one with Dr. Ed. How many you need depends on your condition and how your body responds, so Dr. Ed sets the plan after your first evaluation rather than guessing up front.</p></details>
        <details><summary>Will I see Dr. Ed every time?</summary><p>Yes. Every visit is one-on-one with Dr. Ed, from the first evaluation through discharge.</p></details>
        <details><summary>What should I wear?</summary><p>Comfortable clothes you can move in. Shorts for knee, hip or ankle issues, and a tank top or loose shirt for shoulder, neck and back.</p></details>
        <details><summary>Can you treat kids and teen athletes?</summary><p>Yes. School-age children and teenagers are welcome, including gymnasts and dancers, with a parent in the room for every visit.</p></details>
        <details><summary>Do you treat vertigo, dizziness or stroke recovery?</summary><p>Yes. Dr. Ed treats vertigo and balance problems, and works with patients recovering from a stroke on strength, walking and everyday movement.</p></details>
        <details><summary>Do you speak Russian?</summary><p>Yes. Dr. Ed speaks English and Russian, so you can be treated in either.</p></details>
      </div>
    </div>
  </div>
</section>

<section class="book band" id="book" aria-labelledby="h-book">
  <div class="wrap">
    <div class="book-side">
      <h2 id="h-book">Book your physical therapy evaluation</h2>
      <p class="lede">Tell us what is hurting and when you would like to come in. We confirm your time by phone or email, usually the same day.</p>
      <p class="call-line">Prefer to talk? Call <a href="tel:+18187493205">(818) 749-3205</a><small>Dr. Ed answers his own phone.</small></p>
      <img src="/img/dr-ed-explaining-anatomy-chatsworth.webp" width="1200" height="960" alt="Dr. Ed explaining an anatomy chart to a patient" loading="lazy" decoding="async">
    </div>
    <BookingForm pageName="Home" />
  </div>
</section>
<script is:inline>
(function(){
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Hero: measure where the headline naturally breaks, wrap each line in a mask so it can rise, then restore the plain text
  var h1=document.getElementById('h1');
  if(h1&&!reduce){
    // Probe pieces are words, split again after hyphens, so a break inside "one-on-one" is caught too
    var text=h1.textContent, pieces=text.trim().match(/[^\s-]+-?|\s+/g)||[], probes=[];
    h1.textContent='';
    pieces.forEach(function(pc){ if(/^\s+$/.test(pc)){ h1.appendChild(document.createTextNode(' ')); if(probes.length) probes[probes.length-1].space=true; } else { var sp=document.createElement('span'); sp.textContent=pc; h1.appendChild(sp); probes.push({el:sp,space:false}); } });
    var lines=[], lastTop=null;
    probes.forEach(function(pr){ var t=Math.round(pr.el.getBoundingClientRect().top); if(t!==lastTop){ lines.push(''); lastTop=t; } lines[lines.length-1]+=pr.el.textContent+(pr.space?' ':''); });
    h1.textContent=''; h1.classList.add('playing');
    lines.forEach(function(ln,i){ var o=document.createElement('span'); o.className='line'; var n=document.createElement('span'); n.className='line-in'; n.style.setProperty('--i',i); n.textContent=ln.trim(); o.appendChild(n); h1.appendChild(o); });
    var restored=false; function restore(){ if(restored) return; restored=true; h1.textContent=text; h1.classList.remove('playing'); }
    var last=h1.lastChild&&h1.lastChild.firstChild; if(last) last.addEventListener('animationend',restore);
    setTimeout(restore,1800);
  }
})();
</script>
</BaseLayout>
